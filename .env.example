# Safe local-development defaults. Copy to .env and replace passwords/keys.
POSTGRES_DB=insurance_platform
POSTGRES_USER=insurance_platform
POSTGRES_PASSWORD=change-me-local-only

VLM_ENGINE=mock
VLM_POST_CORRECTION_PROVIDER=disabled
# For Docker Compose: location of the local ADC JSON created by
# `gcloud auth application-default login`. This file must never be committed.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=
GEMINI_GOOGLE_CLOUD_PROJECT=
GEMINI_GOOGLE_CLOUD_LOCATION=global
# Vertex AI's currently documented model ID. Replace only if your project exposes another ID.
GEMINI_POST_CORRECTION_MODEL=gemini-3.5-flash
VLM_API_KEY=local-vlm-key
VLM_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
# For llama_cpp, use an address reachable from the VM/Compose host (LAN or VPN),
# not 127.0.0.1 unless llama.cpp runs inside that same network namespace.
VLM_LLAMA_URL=http://127.0.0.1:8081
VLM_LLAMA_MODEL=Qwen3VL-2B-Instruct-Q4_K_M.gguf
VLM_LLAMA_TIMEOUT_SECONDS=900
VLM_MAX_NEW_TOKENS=900
VLM_IMAGE_MIN_PIXELS=65536
VLM_IMAGE_MAX_PIXELS=131072
VLM_PRELOAD_MODEL=false
HF_TOKEN=

MAX_UPLOAD_MB=25
MAX_PAGES=10
LAYOUT_CPU_THREADS=4
PADDLE_RUN_MODE=auto
REQUEST_TIMEOUT_SECONDS=300
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.25
VLM_POLL_INTERVAL_SECONDS=0.5
VLM_POLL_TIMEOUT_SECONDS=1200
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.tif,.tiff

# Internal Compose URLs: never replace these with localhost inside containers.
DOCUMENT_PROCESSING_URL=http://document-processing-layer:8000
VISUAL_FIELD_URL=http://visual-field-detection:8000
OCR_URL=http://ocr-fastapi-service:8000
INSURANCE_VLM_URL=http://insurance-vlm:8000

# Conservative VLM OCR post-correction. Corrections remain flagged for human review.
LLM_POST_CORRECTION_ENABLED=false
LLM_POST_CORRECTION_URL=http://insurance-vlm:8000
LLM_POST_CORRECTION_TIMEOUT_SECONDS=180
SEED_DEFAULT_TEMPLATE=false

# Standalone Vite development only:
VITE_API_BASE_URL=http://localhost:8000

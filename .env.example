# Safe local-development defaults. Copy to .env and replace passwords/keys.
POSTGRES_DB=insurance_platform
POSTGRES_USER=insurance_platform
POSTGRES_PASSWORD=change-me-local-only

VLM_ENGINE=mock
VLM_API_KEY=local-vlm-key
VLM_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
VLM_PRELOAD_MODEL=false
HF_TOKEN=

MAX_UPLOAD_MB=25
MAX_PAGES=10
LAYOUT_CPU_THREADS=4
PADDLE_RUN_MODE=auto
REQUEST_TIMEOUT_SECONDS=90
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.25
VLM_POLL_INTERVAL_SECONDS=0.5
VLM_POLL_TIMEOUT_SECONDS=180
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.tif,.tiff

# Internal Compose URLs: never replace these with localhost inside containers.
DOCUMENT_PROCESSING_URL=http://document-processing-layer:8000
VISUAL_FIELD_URL=http://visual-field-detection:8000
OCR_URL=http://ocr-fastapi-service:8000
INSURANCE_VLM_URL=http://insurance-vlm:8000

# Standalone Vite development only:
VITE_API_BASE_URL=http://localhost:8000
